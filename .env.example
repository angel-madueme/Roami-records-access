# Postgres connection string used by Prisma.
# Local dev: local Docker Postgres container (PRD Section 10).
# Demo: free-tier hosted Postgres, e.g. Neon or Supabase (PRD Section 10).
# DATABASE_URL="postgresql://user:password@localhost:5432/roami?schema=public"

# Secret used to sign the opaque session id stored in the session cookie.
# Generate a long random value, e.g. `openssl rand -hex 32`. Never commit the real value.
# SESSION_SECRET=""

# SMTP config for Nodemailer, used to send verification and password reset emails.
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""

# Sender address shown to recipients on the `From` header — should match SMTP_USER. Optional; falls back to a Roami default if unset.
# SMTP_FROM_EMAIL=""

# Display name shown instead of the raw address, e.g. "Roami". Optional; falls back to a Roami default if unset.
# SMTP_FROM_NAME=""

# Gemini API key for AI features.
# GEMINI_API_KEY=""

# DeepSeek API key for AI features.
# DEEPSEEK_API_KEY=""

# Unsplash access key for image search.
# UNSPLASH_ACCESS_KEY=""
